# Environment
.env
.env.*.local

# Dependencies
/vendor
/node_modules

# Build output
/api/public/build
/web/dist
/web/node_modules

# Laravel
/api/storage/*.key
/api/storage/framework/cache/*
/api/storage/framework/sessions/*
/api/storage/framework/views/*
/api/storage/logs/*
/api/bootstrap/cache/*

# Claude Code local overrides (settings.json is committed, .local is not)
.claude/settings.local.json

# Scratch space for subagent-driven plan execution: ledgers, briefs,
# review packages. Regenerable, and the git history is the real record.
.superpowers/

# Written and removed again by scripts/check-bundle-secrets.sh, which builds
# with a canary token to prove it does not reach the bundle. Present mid-run
# only, and left behind if the trap cannot catch how it died.
/web/.bundle-secrets-out
/web/.env.production.local

# Playwright MCP drops snapshots and console logs here when an agent
# drives the dev server. Regenerable, and never worth reviewing.
.playwright-mcp/

# Editors and OS
.DS_Store
.idea
.vscode
*.swp
