# Every value the project needs, and where each block goes:
#
#   api/.env    database and Laravel blocks
#   web/.env    the frontend block
#   shell env   DB_HOST, DB_PORT and the read-only pair, which .mcp.json
#               expands as ${VAR} when Claude Code starts
#
# Ask the team for real values; never commit a filled-in .env

# Shared MySQL, self-hosted on the team's Oracle Cloud VPS
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=reflection_diary
DB_USERNAME=
DB_PASSWORD=

# Read-only credentials used by the MySQL MCP server so agents can inspect
# the schema without being able to modify it
DB_READONLY_USER=
DB_READONLY_PASSWORD=

# Laravel
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
