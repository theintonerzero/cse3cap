# Every value the project needs, and where each block goes:
#
#   api/.env    database and Laravel blocks
#   web/.env    the frontend block
#   shell env   DB_READONLY_PASSWORD only, which .mcp.json expands when
#               Claude Code starts. Everything else it needs has a
#               default baked in, so that one line is the whole setup.
#
# Only the two passwords are secret. Host, port, database and usernames
# are here because they are not worth four people asking for.
# Ask the team channel for the passwords; never commit a filled-in .env

# Shared MySQL 9.7 LTS, self-hosted on the team's Oracle Cloud VPS
DB_CONNECTION=mysql
DB_HOST=rddb.darkovski.dev
DB_PORT=3306
DB_DATABASE=reflection_diary
DB_USERNAME=diary_app
DB_PASSWORD=

# The server refuses unencrypted connections, and PDO does not negotiate
# TLS at all unless it is handed a CA file, so without this Laravel fails
# with a misleading "Access denied" rather than a TLS error. The path is
# relative to api/, which is where artisan runs. Use an absolute path if
# your setup runs PHP from somewhere else.
MYSQL_ATTR_SSL_CA=../db/letsencrypt-roots.pem

# Must match what the schema actually created, which is the MySQL 9 server
# default. Laravel ships with utf8mb4_unicode_ci, and the mismatch only
# surfaces when a query compares a literal against a string column derived
# inside a view, where MySQL refuses rather than coercing.
DB_COLLATION=utf8mb4_0900_ai_ci

# Read-only account used by the MySQL MCP server so agents can inspect
# the schema without being able to change it. Export DB_READONLY_PASSWORD
# in your shell profile as well, or the MCP server cannot start.
DB_READONLY_USER=diary_ro
DB_READONLY_PASSWORD=

# Laravel
APP_NAME="Reflection Diary"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# APP_KEY is per developer and is generated, not shared. Run
# `php artisan key:generate` in api/ after copying this file.
APP_KEY=

# Laravel defaults all three of these to `database`, which expects the
# cache, jobs and sessions tables its stock migrations create. We deleted
# those migrations, because this API owns a schema that was designed
# before Laravel arrived and does not include them. Leaving the defaults
# in place fails at runtime rather than at boot, which is the worst way
# to find out.
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Vite's dev origin, allowed through CORS.
FRONTEND_URL=http://localhost:5173

# Your own test database on the shared instance. Never point this at
# reflection_diary: the test suite runs migrate:fresh, which would drop
# the schema for all five of you. diary_app is granted DDL on
# reflection_diary_test_% precisely so this can be yours alone.
DB_TEST_DATABASE=reflection_diary_test_yourname

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
