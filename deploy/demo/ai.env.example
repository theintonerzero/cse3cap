# The AI sidecar's settings on the box (CAP-69, ADR #64). Copy to
# /home/ubuntu/diary/shared/ai.env, mode 0600, and fill in. Never commit the
# real one: it holds the Anthropic key and the diary_ai password.
#
# Off until everything below is filled in and checked; with it off every
# /ai/v1 route answers 404 AI_DISABLED and the app shows no AI.
AI_ENABLED=false

# The diary's API inside the compose network, read with each caller's token.
DIARY_API_BASE=http://diary-web/api/v1

# diary_ai, its own database and user (grants on diary_ai only). Empty until it
# exists; then mysql://diary_ai:<password>@rddb.darkovski.dev:3306/diary_ai
DATABASE_URL=
# TLS with the certificate's name checked, against the API's own roots.
DATABASE_CA=/app/db/letsencrypt-roots.pem

ANTHROPIC_API_KEY=
DAILY_CAP_USD=5
