# Not the source of truth. The repository root .env.example holds every
# value this project needs, including the ones Laravel does not know
# about, and scripts/setup.sh copies it here as api/.env.
#
#   cd .. && ./scripts/setup.sh
#
# Kept as a signpost rather than deleted, because Laravel's convention is
# to look here first and an empty answer sends people to Stack Overflow.
