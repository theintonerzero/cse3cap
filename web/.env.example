# web/ environment. Copy the lines you need into web/.env.local (git-ignored).
# The demo shell's two go in web/.env.development.local instead: the dev
# server reads it, a production build never does (F15, docs/Security-Review.md).
# Vite only exposes variables prefixed VITE_.

# Where the API lives, including the version prefix, no trailing slash.
# Normally written by scripts/setup.sh.
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# A seeded bearer token, a dev convenience only (the running app takes its
# token from the shell, not from here).
# VITE_API_TOKEN=

# --- Demo shell (CAP-51, ADR #60). Off unless VITE_DEMO_SHELL=1. ---
# Turns on the Alumable-branded sign-in and My Gigs home around the diary.
# Demo-only; leave unset for the product build.
# VITE_DEMO_SHELL=1

# One-click demo personas, as a JSON array. Keep the real seeded tokens only
# in web/.env.development.local, never committed. Absent, the welcome falls back to the
# seeded-token paste.
# VITE_DEMO_TOKENS=[{"id":"jane","name":"Jane N","role_hint":"Student","slot":"student","token":"1|..."},{"id":"noor","name":"Noor A","role_hint":"Student","slot":"student","token":"1|..."},{"id":"sam","name":"Sam O","role_hint":"Assessor","slot":"assessor","token":"1|..."},{"id":"lee","name":"Dr Lee","role_hint":"Supervisor","slot":"supervisor","token":"1|..."}]
