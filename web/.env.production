# Read by `vite build` only (CAP-26). No secret, and no hostname: the demo
# serves the frontend and the API from one origin, so the relative path is
# enough and nothing about the host is compiled into the bundle.
#
# Never add VITE_API_TOKEN here or anywhere a production build can see it.
# Vite compiles it into public JavaScript as a string literal (F1 in
# docs/Security-Review.md). scripts/deploy.sh builds with it unset and fails
# the deploy if a token shape reaches the bundle.
VITE_API_BASE_URL=/api/v1
# The AI sidecar (ADR #64), on the same origin. Asked once per session; when
# it is off (404 AI_DISABLED) or not there at all, the app shows no AI.
VITE_AI_BASE_URL=/ai/v1
